<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\OpControl.Parental.Contracts\OpControl.Parental.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="QRCoder" Version="1.8.1" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup Condition="'$(BuildDate)' != ''">
    <AssemblyMetadata Include="BuildDate" Value="$(BuildDate)" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\ai-category.json" LogicalName="ai-category.json" />
  </ItemGroup>

  <!-- The dashboard About credits are generated from the real dependency graph:
       the server packages plus the kid view's packages, licenses and fonts. -->
  <PropertyGroup>
    <AboutCreditsAssets>$(ProjectAssetsFile)</AboutCreditsAssets>
    <KidViewAssetsFile>$(MSBuildProjectDirectory)/../OpControl.Parental.Luna/obj/project.assets.json</KidViewAssetsFile>
    <AboutCreditsAssets Condition="Exists('$(KidViewAssetsFile)')">$(AboutCreditsAssets);$(KidViewAssetsFile)</AboutCreditsAssets>
  </PropertyGroup>
  <Target Name="GenerateAboutCredits"
          BeforeTargets="AssignTargetPaths"
          Inputs="$(AboutCreditsAssets);$(MSBuildProjectDirectory)/../../tools/generate-third-party-credits.cs"
          Outputs="$(IntermediateOutputPath)credits/third-party-credits.json;$(IntermediateOutputPath)credits/third-party-credits.md">
    <MakeDir Directories="$(MSBuildProjectDirectory)/$(IntermediateOutputPath)gen-tmp;$(MSBuildProjectDirectory)/$(IntermediateOutputPath)gen-home" />
    <Exec Command="&quot;$(DOTNET_HOST_PATH)&quot; run --file &quot;$(MSBuildProjectDirectory)/../../tools/generate-third-party-credits.cs&quot; -- &quot;$(AboutCreditsAssets)&quot; &quot;$(NuGetPackageRoot).&quot; &quot;$(TargetFramework)&quot; &quot;$(MSBuildProjectDirectory)&quot; &quot;$(MSBuildProjectDirectory)/../..&quot; &quot;$(IntermediateOutputPath)credits&quot;"
          EnvironmentVariables="TMP=$(MSBuildProjectDirectory)/$(IntermediateOutputPath)gen-tmp;TEMP=$(MSBuildProjectDirectory)/$(IntermediateOutputPath)gen-tmp;TMPDIR=$(MSBuildProjectDirectory)/$(IntermediateOutputPath)gen-tmp;XDG_DATA_HOME=$(MSBuildProjectDirectory)/$(IntermediateOutputPath)gen-home;LOCALAPPDATA=$(MSBuildProjectDirectory)/$(IntermediateOutputPath)gen-home;DOTNET_CLI_HOME=$(MSBuildProjectDirectory)/$(IntermediateOutputPath)gen-home;DOTNET_CLI_TELEMETRY_OPTOUT=1" />
    <ItemGroup>
      <EmbeddedResource Include="$(IntermediateOutputPath)credits/third-party-credits.json" LogicalName="OpControl.Parental.Server.ThirdPartyCredits.json" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <Content Include="..\..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
