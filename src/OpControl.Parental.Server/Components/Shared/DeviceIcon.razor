@using OpControl.Parental.Contracts
@inject IStringLocalizer<AppStrings> L

<span class="device-icon @(Online ? "online" : "offline")" role="img" aria-label="@Label">
    <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor"
         stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        @if (IsPhone)
        {
            <rect x="7" y="2.5" width="10" height="19" rx="2.5" />
            <path d="M10.5 18.5h3" />
        }
        else
        {
            <rect x="3.5" y="4" width="17" height="12" rx="2" />
            <path d="M2 19h20" />
            <path d="M4.5 16l-1 3" />
            <path d="M19.5 16l1 3" />
        }
    </svg>
</span>

@code {
    [Parameter] public DevicePlatform Platform { get; set; }
    [Parameter] public bool Online { get; set; }

    private bool IsPhone => Platform == DevicePlatform.Android;

    private string Label => L["Device.Icon.Aria",
        L[IsPhone ? "Device.Icon.Phone" : "Device.Icon.Laptop"].Value,
        L[Online ? "Device.Icon.Online" : "Device.Icon.Offline"].Value].Value;
}
