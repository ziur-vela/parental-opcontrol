<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Package Name="Parental OpControl"
           Manufacturer="OpControl IT Solutions"
           Version="$(var.ProductVersion)"
           UpgradeCode="dc5fb7b2-a7e6-4d02-b798-8b556150ceec"
           Scope="perMachine"
           Language="1033"
           Compressed="yes">

    <SummaryInformation Description="!(loc.SummaryDescription)" Manufacturer="OpControl IT Solutions" />

    <MajorUpgrade AllowDowngrades="yes" Schedule="afterInstallInitialize" />
    <MediaTemplate EmbedCab="yes" />

    <Property Id="SERVER" Secure="yes" />
    <Property Id="CODE" Secure="yes" />
    <Property Id="ACCOUNT" Secure="yes" />
    <Property Id="SUPPRESSDATA" Secure="yes" />
    <Property Id="ARPPRODUCTICON" Value="ProductIcon" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <Icon Id="ProductIcon" SourceFile="$(var.ProductIcon)" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLROOT" Name="OpControlParental">
        <Directory Id="CLIENTDIR" Name="Client" />
        <Directory Id="HELPERDIR" Name="Helper" />
        <Directory Id="LUNADIR" Name="Luna" />
        <Directory Id="LEGALDIR" Name="legal">
          <Directory Id="LEGALFONTS" Name="fonts" />
        </Directory>
      </Directory>
    </StandardDirectory>

    <Feature Id="Main" Title="!(loc.FeatureTitle)" Level="1" AllowAbsent="no">
      <ComponentGroupRef Id="ClientComponents" />
      <ComponentGroupRef Id="HelperComponents" />
      <ComponentGroupRef Id="LunaComponents" />
      <ComponentGroupRef Id="BrandComponents" />
      <ComponentGroupRef Id="LegalComponents" />
    </Feature>

    <ComponentGroup Id="ClientComponents">
      <Component Id="ClientExe" Guid="*" Directory="CLIENTDIR">
        <File Id="ClientExeFile" Source="$(var.ClientDir)/OpControl.Parental.Client.exe" KeyPath="yes" />
        <ServiceInstall Id="ServiceInstall"
                        Name="OpControlParental"
                        DisplayName="!(loc.ServiceDisplayName)"
                        Description="!(loc.ServiceDescription)"
                        Type="ownProcess"
                        Start="auto"
                        ErrorControl="normal"
                        Account="LocalSystem" />
        <ServiceControl Id="ServiceControl"
                        Name="OpControlParental"
                        Start="install"
                        Stop="both"
                        Remove="uninstall"
                        Wait="yes" />
        <util:ServiceConfig ServiceName="OpControlParental"
                            FirstFailureActionType="restart"
                            SecondFailureActionType="restart"
                            ThirdFailureActionType="restart"
                            RestartServiceDelayInSeconds="5"
                            ResetPeriodInDays="1" />
      </Component>
      <Component Id="ClientSettings" Guid="*" Directory="CLIENTDIR">
        <File Id="ClientAppSettings" Source="$(var.ClientDir)/appsettings.json" KeyPath="yes" />
      </Component>
      <Component Id="MsiConfig" Guid="*" Directory="INSTALLROOT" Condition="NOT Installed">
        <RegistryKey Root="HKLM" Key="Software\OpControl\Parental">
          <RegistryValue Name="Server" Type="string" Value="[SERVER]" KeyPath="yes" />
          <RegistryValue Name="Code" Type="string" Value="[CODE]" />
          <RegistryValue Name="Account" Type="string" Value="[ACCOUNT]" />
        </RegistryKey>
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="HelperComponents">
      <Component Id="HelperExe" Guid="*" Directory="HELPERDIR">
        <File Id="HelperExeFile" Source="$(var.HelperDir)/OpControl.Parental.Helper.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="LunaComponents">
      <Component Id="LunaExe" Guid="*" Directory="LUNADIR">
        <File Id="LunaExeFile" Source="$(var.LunaDir)/OpControl.Parental.Luna.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="LegalComponents">
      <Component Id="LegalLicense" Guid="2c009b6e-b134-4383-b6c7-2ba6dcda47e9" Directory="LEGALDIR">
        <File Id="LicenseFile" Source="$(var.LegalDir)\LICENSE" KeyPath="yes" />
      </Component>
      <Component Id="LegalNotices" Guid="18db0528-c3c5-46df-8d0f-47885018fe6a" Directory="LEGALDIR">
        <File Id="ThirdPartyNoticesFile" Source="$(var.LegalDir)\THIRD-PARTY-NOTICES.md" KeyPath="yes" />
      </Component>
      <Component Id="LegalFontFredoka" Guid="f648a3c5-7303-4844-bf03-f1b491d7b56d" Directory="LEGALFONTS">
        <File Id="OflFredoka" Source="$(var.LegalDir)\fonts\OFL-Fredoka.txt" KeyPath="yes" />
      </Component>
      <Component Id="LegalFontNunito" Guid="c00b8132-6e7e-45ff-b0d1-ea4d655a6dbe" Directory="LEGALFONTS">
        <File Id="OflNunito" Source="$(var.LegalDir)\fonts\OFL-Nunito.txt" KeyPath="yes" />
      </Component>
      <Component Id="LegalFontIbmPlexMono" Guid="5ecf764b-8b03-45f1-abc4-89a212270e2c" Directory="LEGALFONTS">
        <File Id="OflIbmPlexMono" Source="$(var.LegalDir)\fonts\OFL-IBM-Plex-Mono.txt" KeyPath="yes" />
      </Component>
      <Component Id="LegalFontManrope" Guid="286a0e82-5e93-4164-bc3a-cb83244beb0d" Directory="LEGALFONTS">
        <File Id="OflManrope" Source="$(var.LegalDir)\fonts\OFL-Manrope.txt" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="BrandComponents">
      <Component Id="BrandFiles" Guid="*" Directory="INSTALLROOT">
        <File Id="BrandIcon" Source="$(var.BrandIcon)" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <CustomAction Id="PrepareLegacyInstall"
                  Directory="SystemFolder"
                  ExeCommand="[SystemFolder]cmd.exe /c sc stop OpControlParental &gt;nul 2&gt;&amp;1 &amp; ping -n 3 127.0.0.1 &gt;nul &amp; sc delete OpControlParental &gt;nul 2&gt;&amp;1 &amp; taskkill /f /im OpControl.Parental.Helper.exe &gt;nul 2&gt;&amp;1 &amp; schtasks /delete /tn &quot;OpControl Parental Helper&quot; /f &gt;nul 2&gt;&amp;1"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />


    <CustomAction Id="ReportUninstall"
                  Directory="SystemFolder"
                  ExeCommand="[SystemFolder]cmd.exe /c powershell.exe -NoProfile -ExecutionPolicy Bypass -EncodedCommand "
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <CustomAction Id="MarkUninstall"
                  Directory="SystemFolder"
                  ExeCommand="[SystemFolder]cmd.exe /c echo uninstall &gt; &quot;%ProgramData%\OpControlParental\uninstall-in-progress.flag&quot;"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <CustomAction Id="RemoveClientData"
                  Directory="SystemFolder"
                  ExeCommand="[SystemFolder]cmd.exe /c rmdir /s /q &quot;%ProgramData%\OpControlParental&quot;"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="PrepareLegacyInstall" Before="InstallFiles" Condition="NOT Installed OR WIX_UPGRADE_DETECTED" />
      <Custom Action="ReportUninstall" Before="StopServices" Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE AND NOT SUPPRESSDATA" />
      <Custom Action="MarkUninstall" Before="StopServices" Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE AND NOT SUPPRESSDATA" />
      <Custom Action="RemoveClientData" After="RemoveFiles" Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE AND NOT SUPPRESSDATA" />
    </InstallExecuteSequence>
  </Package>
</Wix>
