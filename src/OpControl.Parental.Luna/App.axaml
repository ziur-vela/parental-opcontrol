<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="clr-namespace:LiveMarkdown.Avalonia;assembly=LiveMarkdown.Avalonia"
             x:Class="OpControl.Parental.Luna.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://LiveMarkdown.Avalonia/Styles.axaml" />

    <!-- Kid-friendly markdown: body font, small headings, soft tips, no code chrome. -->
    <Style Selector="md|MarkdownTextBlock">
      <Setter Property="FontFamily" Value="avares://OpControl.Parental.Luna/Assets/Fonts#Nunito" />
      <Setter Property="FontSize" Value="14.5" />
      <Setter Property="LineHeight" Value="21" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="TextAlignment" Value="Left" />
    </Style>
    <Style Selector="md|CodeBlock">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontFamily" Value="avares://OpControl.Parental.Luna/Assets/Fonts#Nunito" />
    </Style>
    <Style Selector="md|CodeBlock /template/ Button#PART_CopyButton">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="md|CodeBlock /template/ ToggleButton#PART_ToggleTextWrapButton">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="md|CodeBlock /template/ TextBlock#PART_LanguageTextBlock">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="md|MarkdownRenderer">
      <Style Selector="^ Border.Heading1Block md|MarkdownTextBlock">
        <Setter Property="FontFamily" Value="avares://OpControl.Parental.Luna/Assets/Fonts#Fredoka" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Margin" Value="0,4,0,2" />
      </Style>
      <Style Selector="^ Border.Heading2Block md|MarkdownTextBlock">
        <Setter Property="FontFamily" Value="avares://OpControl.Parental.Luna/Assets/Fonts#Fredoka" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Margin" Value="0,4,0,2" />
      </Style>
      <Style Selector="^ Border.Heading3Block md|MarkdownTextBlock">
        <Setter Property="FontFamily" Value="avares://OpControl.Parental.Luna/Assets/Fonts#Fredoka" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Margin" Value="0,3,0,1" />
      </Style>
      <Style Selector="^ Border.QuoteBlock">
        <Setter Property="Background" Value="{DynamicResource SecondaryCardBackgroundColor}" />
        <Setter Property="BorderBrush" Value="{DynamicResource QuoteBorderColor}" />
        <Setter Property="BorderThickness" Value="3,0,0,0" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Margin" Value="0,2" />
      </Style>
      <Style Selector="^ Border.Table">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundColor}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Margin" Value="0,4" />
      </Style>
      <Style Selector="^ Border.TableCell">
        <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
        <Setter Property="Padding" Value="0,3,10,3" />
      </Style>
      <Style Selector="^ md|CodeInline">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontFamily" Value="avares://OpControl.Parental.Luna/Assets/Fonts#Nunito" />
        <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
        <Setter Property="Padding" Value="0" />
      </Style>
      <Style Selector="^ md|Link">
        <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
      </Style>
      <Style Selector="^ TextBlock.ListBlockBullet">
        <Setter Property="FontFamily" Value="avares://OpControl.Parental.Luna/Assets/Fonts#Nunito" />
      </Style>
      <Style Selector="^ TextBlock.ListBlockNumber">
        <Setter Property="FontFamily" Value="avares://OpControl.Parental.Luna/Assets/Fonts#Nunito" />
      </Style>
    </Style>
  </Application.Styles>
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://LiveMarkdown.Avalonia/Defaults.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
