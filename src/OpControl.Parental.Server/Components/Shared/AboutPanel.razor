@using System.Net
@using System.Text
@using Microsoft.EntityFrameworkCore
@using OpControl.Parental.Server.Data
@using OpControl.Parental.Server.Pages
@inject AuthenticationStateProvider AuthState
@inject IServiceScopeFactory Scopes
@inject BuildInfo Build
@inject DevicePresenceService Presence
@inject ReleaseCatalog Releases
@inject IStringLocalizer<AppStrings> L

<div class="page-head">
    <div>
        <div class="eyebrow">@L["AboutPage.Eyebrow"]</div>
        <h1>@L["AboutPage.ProductTitle"]</h1>
        <p class="muted">@L["AboutPage.Subtitle"]</p>
    </div>
</div>

<section class="card about-brand-card">
    <div class="about-brand">
        <img class="about-shield" src="/brand/icon-color.svg" alt="@L["AboutPage.ProductTitle"]" />
        <div class="about-brand-copy">
            <div class="brand-title">@L["AboutPage.ProductTitle"]</div>
            <p class="about-author">@Rich(L["AboutPage.AuthorLine"].Value)</p>
        </div>
        <img class="about-opc-logo" src="/brand/opcontrol-logo.png" alt="OpControl IT Solutions" width="183" height="40" />
    </div>
</section>

<section class="card about-version-card">
    <div class="card-title-row about-version-head">
        <div class="about-version-head-left">
            <span class="eyebrow about-version-eyebrow">@L["AboutPage.VersionTitle"]</span>
            <span class="beta-badge">@L["AboutPage.BetaBadge"]</span>
        </div>
        <a class="about-release-link" href="https://github.com/ziur-vela/parental-opcontrol/releases/tag/v@(Build.Version)" target="_blank" rel="noopener">@L["AboutPage.ReleaseNotes"] ↗</a>
    </div>
    <div class="about-version-body">
        <div class="about-beta-banner" role="note">
            <svg class="about-beta-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 3l9.5 17h-19z"></path><path d="M12 10v4"></path><path d="M12 17.5v.01"></path>
            </svg>
            <span>@L["AboutPage.BetaNotice"]</span>
        </div>
        <div class="about-version-table" role="table">
            <div class="about-version-row about-version-row-head" role="row">
                <span class="about-cell" role="columnheader">@L["AboutPage.Component"]</span>
                <span class="about-cell" role="columnheader">@L["AboutPage.VersionColumn"]</span>
                <span class="about-cell" role="columnheader">@L["AboutPage.StatusColumn"]</span>
                <span class="about-cell about-cell-right" role="columnheader">@L["AboutPage.LastSeenColumn"]</span>
            </div>
            <div class="about-version-row" role="row">
                <span class="about-cell about-cell-component" role="cell">
                    <span class="about-cell-label">@L["AboutPage.Component"]</span>
                    <span class="about-component-line"><span class="about-component-name">@L["AboutPage.Server"]</span></span>
                </span>
                <span class="about-cell about-mono about-version-number" role="cell">
                    <span class="about-cell-label">@L["AboutPage.VersionColumn"]</span>@ServerVersionLabel
                </span>
                <span class="about-cell about-mono about-status-build" role="cell">
                    <span class="about-cell-label">@L["AboutPage.StatusColumn"]</span>@ServerBuildLine
                </span>
                <span class="about-cell about-cell-right" role="cell">
                    <span class="about-cell-label">@L["AboutPage.LastSeenColumn"]</span>@L["AboutPage.Running"]
                </span>
            </div>
            @if (_devices.Count == 0)
            {
                <p class="muted small about-version-empty">@L["AboutPage.NoDevices"]</p>
            }
            else
            {
                @foreach (var device in _devices)
                {
                    var status = VersionDisplay.Status(device.Version, _latestRelease, device.Online);
                    <div class="about-version-row" role="row" @key="device.DeviceId">
                        <span class="about-cell about-cell-component" role="cell">
                            <span class="about-cell-label">@L["AboutPage.Component"]</span>
                            <span class="about-component-line">
                                <span class="about-component-name">@device.Name</span>
                                @if (!string.IsNullOrWhiteSpace(device.ChildName))
                                {
                                    <span class="about-child">· @device.ChildName</span>
                                }
                            </span>
                        </span>
                        <span class="about-cell about-mono" role="cell">
                            <span class="about-cell-label">@L["AboutPage.VersionColumn"]</span>@ClientVersion(device.Version)
                        </span>
                        <span class="about-cell" role="cell">
                            <span class="about-cell-label">@L["AboutPage.StatusColumn"]</span>
                            @if (status.Kind == AboutStatusKind.UpToDate)
                            {
                                <span class="about-status ok">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg>
                                    @L["AboutPage.UpToDate"]@(status.Offline ? L["AboutPage.OfflineSuffix"] : "")
                                </span>
                            }
                            else
                            {
                                <span class="about-status warn">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M12 5v10"></path><path d="M7.5 11l4.5 4.5 4.5-4.5"></path><path d="M5 19.5h14"></path></svg>
                                    @L["AboutPage.UpdateAvailable"]@(status.Offline ? L["AboutPage.OfflineSuffix"] : "")
                                </span>
                            }
                        </span>
                        <span class="about-cell about-cell-right" role="cell">
                            <span class="about-cell-label">@L["AboutPage.LastSeenColumn"]</span>@LastSeenText(device.LastSeenUtc)
                        </span>
                    </div>
                }
            }
        </div>
    </div>
</section>

<section class="card" id="license">
    <h2>@L["AboutPage.LicenseTitle"]</h2>
    <div class="about-license-block">
        <p class="about-license-name">@L["AboutPage.LicenseName"]</p>
        <p class="muted">@L["AboutPage.LicenseSummary"]</p>
        <p class="muted small">@L["AboutPage.CopyrightFull"]</p>
        <details class="about-license">
            <summary>@L["AboutPage.ReadFullLicense"]</summary>
            <pre class="legal-text">@_licenseText</pre>
        </details>
    </div>
</section>

<section class="card">
    <h2>@L["AboutPage.CreditsTitle"]</h2>
    <div class="about-credits">
        <h3 class="about-subhead">@L["AboutPage.BuiltWithAiTitle"]</h3>
        <p class="about-ai">@Rich(L["Layout.BuiltWithAi"].Value)</p>
        <h3 class="about-subhead">@L["AboutPage.ThirdParty"]</h3>
        <p class="muted small">@L["AboutPage.ThirdPartyHint"]</p>
        @if (_credits.Components.Count == 0)
        {
            <p class="muted small">@L["AboutPage.ThirdPartyEmpty"]</p>
        }
        else
        {
            <div class="credit-list" role="list">
                @foreach (var component in _credits.Components)
                {
                    <div class="credit-row" role="listitem">
                        <span class="credit-name">
                            @component.Name
                            @if (!string.IsNullOrWhiteSpace(component.Version)) { <span class="muted tiny">@component.Version</span> }
                        </span>
                        <span class="credit-license">@component.License</span>
                    </div>
                }
            </div>
        }
    </div>
</section>

@code {
    private sealed record DeviceRow(Guid DeviceId, string Name, string? ChildName, string? Version, DateTime? LastSeenUtc, bool Online);

    private IReadOnlyList<DeviceRow> _devices = [];
    private ThirdPartyCreditsDto _credits = new("project.assets.json", []);
    private string _licenseText = "";
    private string? _latestRelease;
    private TimeZoneInfo _timeZone = TimeZoneInfo.Utc;

    private bool IsSpanish => System.Globalization.CultureInfo.CurrentUICulture.Name.StartsWith("es", StringComparison.OrdinalIgnoreCase);

    private string CurrentLanguage => IsSpanish ? AppCulture.Spanish : AppCulture.English;

    private string ServerVersionLabel => VersionDisplay.VersionLabel(Build.Version);

    private string ServerBuildLine => L["AboutPage.Build"].Value + " " + VersionDisplay.BuildLine(Build.BuildDate, Build.ShortCommit, CurrentLanguage);

    protected override async Task OnInitializedAsync()
    {
        _licenseText = LicenseModel.ReadNotice("LICENSE");
        _credits = AboutCredits.Credits;
        _latestRelease = Releases.CurrentInfo()?.Version;

        var auth = await AuthState.GetAuthenticationStateAsync();
        if (!Guid.TryParse(auth.User.FindFirst("family_id")?.Value, out var familyId)) return;
        using var scope = Scopes.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<ParentalDbContext>();
        _timeZone = (await DashboardTime.FamilyZoneInfoAsync(db, familyId)).Zone;
        _devices = await db.Devices.AsNoTracking()
            .Where(device => device.FamilyId == familyId && !device.IsRevoked)
            .OrderBy(device => device.Name)
            .Select(device => new DeviceRow(device.Id, device.Name,
                device.Child != null ? device.Child.Name : null,
                device.ClientVersion, device.LastSeenUtc, false))
            .ToListAsync();
        _devices = _devices
            .Select(device => device with { Online = Presence.IsOnline(device.DeviceId) })
            .ToList();
    }

    private string ClientVersion(string? version)
    {
        var trimmed = version?.Trim().TrimStart('v', 'V');
        return string.IsNullOrWhiteSpace(trimmed) ? L["AboutPage.NotReported"] : $"v{trimmed}";
    }

    private string LastSeenText(DateTime? lastSeenUtc) =>
        lastSeenUtc is { } seen
            ? VersionDisplay.LastSeen(seen, _timeZone, L["AboutPage.Today"].Value, L["AboutPage.Yesterday"].Value, CurrentLanguage)
            : L["Common.Never"].Value;

    private static MarkupString Rich(string text)
    {
        var encoded = WebUtility.HtmlEncode(text);
        var parts = encoded.Split("**");
        var builder = new StringBuilder(encoded.Length + 24);
        for (var index = 0; index < parts.Length; index++)
        {
            if (parts[index].Length == 0) continue;
            if (index % 2 == 1) builder.Append("<strong>").Append(parts[index]).Append("</strong>");
            else builder.Append(parts[index]);
        }
        return new MarkupString(builder.ToString());
    }
}
