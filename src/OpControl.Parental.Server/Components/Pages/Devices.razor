@page "/devices"
@attribute [Authorize(Policy = ParentalPolicies.ManageDevices)]
@rendermode InteractiveServer
@using OpControl.Parental.Server.Auth
@using Microsoft.EntityFrameworkCore
@using OpControl.Parental.Server.Data
@using OpControl.Parental.Server.Services
@using OpControl.Parental.Server.Components.Shared
@inject AuthenticationStateProvider AuthState
@inject IServiceScopeFactory Scopes
@inject DevicePresenceService Presence
@inject DeviceMetricsFocusService MetricsFocus
@inject DashboardEventBus Events
@inject OpControl.Parental.Server.Services.ReleaseCatalog Releases
@inject IJSRuntime JS
@inject IStringLocalizer<AppStrings> L

<PageTitle>@L["Devices.PageTitle"]</PageTitle>

<div class="page-head">
    <div>
        <div class="eyebrow">@L["Settings.FamilyEyebrow"]</div>
        <h1>@L["Nav.Devices"]</h1>
        <p class="muted">@L["Devices.Subtitle"]</p>
    </div>
    <a class="btn btn-primary" href="/add-device">@L["Nav.AddDevice"]</a>
</div>

@if (_error is not null)
{
    <div class="alert danger">@_error</div>
}

<div class="card">
    @if (_devices.Count == 0)
    {
        <p class="muted">@L["Devices.None"]</p>
    }
    else
    {
        <div class="device-list">
            @foreach (var device in _devices)
            {
                var updateStatus = _updateStatuses.GetValueOrDefault(device.DeviceId);
                var updateText = !string.IsNullOrWhiteSpace(updateStatus)
                    ? L["Devices.UpdateStatus", UpdateStatusText(updateStatus)].Value
                    : IsOutdatedCurrent(device) ? L["Devices.UpdateAvailable"].Value : L["Devices.UpdateUpToDate"].Value;
                var automaticZone = _reportedZoneDisplay.GetValueOrDefault(device.DeviceId) ?? TimeZoneResolver.DisplayName(device.TimeZoneId);
                <section class="device-card" @key="device.DeviceId">
                    <div class="device-card-head">
                        <DeviceIcon Platform="@device.Platform" Online="@device.Online" />
                        <div class="device-head-main">
                            <div class="device-name-row">
                                <span class="device-name">@device.Name</span>
                                <span class="os-label">@OsLabel(device.Platform)</span>
                            </div>
                            <div class="device-subline">
                                <span>@ChildName(device.ChildId)</span>
                                <span>·</span>
                                <span>@(string.IsNullOrWhiteSpace(device.ClientVersion) ? L["Common.VersionUnknown"].Value : L["Home.ClientVersion", device.ClientVersion].Value)</span>
                                @if (_currentRelease is not null) { <span>· @L["Devices.Latest", _currentRelease]</span> }
                                <span>· @updateText</span>
                            </div>
                        </div>
                        <div class="device-head-status">
                            <div class="@(device.Online ? "state-online" : "state-offline")">@(device.Online ? L["Common.Online"] : L["Common.Offline"])</div>
                            <div class="muted tiny">@(device.LastSeenUtc is { } seen ? Formats.CompactDateTime(DashboardTime.Convert(seen, device.TimeZoneId)) : L["Common.Never"])</div>
                        </div>
                    </div>

                    <div class="device-card-grid">
                        <label class="field">
                            <span>@L["Devices.TimeZone"]</span>
                            <select value="@(_timeZoneOverrides.GetValueOrDefault(device.DeviceId) ?? "")" @onchange="e => SetTimeZoneAsync(device, e.Value?.ToString())">
                                <option value="">@L["Devices.TimeZoneAutomatic", automaticZone]</option>
                                @foreach (var zone in TimeZones)
                                {
                                    <option value="@zone.Id">@zone.DisplayName</option>
                                }
                            </select>
                        </label>
                        <label class="field">
                            <span>@L["Devices.ClientLanguage"]</span>
                            <select value="@(_deviceLanguages.GetValueOrDefault(device.DeviceId) ?? "")" @onchange="e => SetLanguageAsync(device, e.Value?.ToString())">
                                <option value="">@L["Devices.FollowFamily", FamilyLanguageLabel]</option>
                                <option value="en">@L["Language.English"]</option>
                                <option value="es-MX">@L["Language.Spanish"]</option>
                            </select>
                        </label>
                    </div>

                    <div class="device-checks">
                        @if (_isOwner && _noticeSettings.TryGetValue(device.DeviceId, out var notice))
                        {
                            <label class="check"><input type="checkbox" checked="@notice.Screen" @onchange="e => SaveNoticeAsync(device.DeviceId, (bool)(e.Value ?? false), notice.Camera, notice.Light)" /> @L["Devices.NoticeScreen"]</label>
                            <label class="check"><input type="checkbox" checked="@notice.Camera" @onchange="e => SaveNoticeAsync(device.DeviceId, notice.Screen, (bool)(e.Value ?? false), notice.Light)" /> @L["Devices.NoticeCamera"]</label>
                            <label class="check"><input type="checkbox" checked="@notice.Light" @onchange="e => SaveNoticeAsync(device.DeviceId, notice.Screen, !(bool)(e.Value ?? false), (bool)(e.Value ?? false))" /> @L["Devices.CameraLight"]</label>
                        }
                        @if (_notifyOffline.TryGetValue(device.DeviceId, out var notifyOffline))
                        {
                            <label class="check"><input type="checkbox" checked="@notifyOffline" @onchange="e => SetNotifyOfflineAsync(device.DeviceId, (bool)(e.Value ?? false))" /> @L["Devices.NotifyOffline"]</label>
                        }
                        @if (_notifyOnline.TryGetValue(device.DeviceId, out var notifyOnline))
                        {
                            <label class="check"><input type="checkbox" checked="@notifyOnline" @onchange="e => SetNotifyOnlineAsync(device.DeviceId, (bool)(e.Value ?? false))" /> @L["Devices.NotifyOnline"]</label>
                        }
                    </div>

                    <div class="system-resources">
                        <div class="system-resources-head">
                            <span class="eyebrow">@L["Devices.SystemResources"]</span>
                        </div>
                        @{
                            var metrics = _metrics.GetValueOrDefault(device.DeviceId);
                            var metricsState = DeviceMetricsMath.State(device.Online, metrics is not null);
                        }
                        @if (metricsState == DeviceMetricsState.Offline)
                        {
                            <p class="muted small">@L["Devices.OfflineLastSeen", SeenText(device)]</p>
                        }
                        else if (metricsState == DeviceMetricsState.Waiting || metrics is null)
                        {
                            <p class="muted small">@L["Devices.WaitingForMetrics"]</p>
                        }
                        else
                        {
                            var ramPercent = DeviceMetricsMath.RamPercent(metrics.RamUsedBytes, metrics.RamTotalBytes);
                            var diskUsed = DeviceMetricsMath.DiskUsedPercent(metrics.DiskFreeBytes, metrics.DiskTotalBytes);
                            var diskFree = DeviceMetricsMath.DiskFreePercent(metrics.DiskFreeBytes, metrics.DiskTotalBytes);
                            <div class="device-gauges">
                                <DeviceGauge Label="@L["Devices.Cpu"]" Percent="@metrics.CpuPercent" Caption="@($"{metrics.CpuPercent}%")"
                                             Amber="@(metrics.CpuPercent >= DeviceMetricsLimits.CpuPercent)" />
                                <DeviceGauge Label="@L["Devices.Ram"]" Percent="@ramPercent" Caption="@Capacity(metrics.RamUsedBytes, metrics.RamTotalBytes)"
                                             Amber="@(ramPercent >= DeviceMetricsLimits.RamPercent)" />
                                <DeviceGauge Label="@L["Devices.Storage"]" Percent="@diskUsed" Caption="@Capacity(metrics.DiskTotalBytes - metrics.DiskFreeBytes, metrics.DiskTotalBytes)"
                                             Amber="@(diskFree < DeviceMetricsLimits.DiskFreePercent)" />
                                <DeviceBattery Label="@L["Devices.Battery"]" Percent="@metrics.BatteryPercent" Caption="@BatteryText(metrics.BatteryState)" />
                                <div class="device-gauge-disabled">
                                    <DeviceGauge Label="@L["Devices.Temperature"]" Percent="0" Caption="@L["Common.ComingSoon"]" />
                                </div>
                                <div class="device-uptime">
                                    <div class="device-uptime-value">@UptimeText(metrics.UptimeSeconds)</div>
                                    <div class="device-gauge-label">@L["Devices.Uptime"]</div>
                                </div>
                            </div>
                            <div class="metrics-updated">@UpdatedText(metrics.UpdatedUtc)</div>
                        }

                        @if (_warnings.TryGetValue(device.DeviceId, out var deviceWarnings) && deviceWarnings.Count > 0)
                        {
                            <div class="device-warnings">
                                <div class="eyebrow">@L["Devices.Warnings"]</div>
                                @foreach (var warning in deviceWarnings)
                                {
                                    <div class="device-warning-row">
                                        <span class="device-warning-kind">@DeviceWarningText.Kind(warning.Kind)</span>
                                        <span class="device-warning-meta">
                                            @L["Devices.WarningPeak", Math.Round(warning.PeakValue)] ·
                                            @WarningDuration(warning) ·
                                            @L["Devices.WarningStarted", Formats.CompactDateTime(DashboardTime.Convert(warning.StartedUtc, device.TimeZoneId))]
                                        </span>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="muted tiny device-warnings-empty">@L["Devices.WarningsNone"]</p>
                        }
                    </div>

                    <div class="device-card-foot">
                        @if (_canMessage)
                        {
                            <details class="inline-message">
                                <summary class="btn btn-ghost">@L["Devices.Message"]</summary>
                                <MessageComposer ChildId="device.ChildId" DeviceId="device.DeviceId" Compact="true" />
                            </details>
                        }
                        @if (device.Platform == DevicePlatform.Windows && _currentRelease is not null && IsOutdatedCurrent(device))
                        {
                            <button type="button" class="ghost-btn" onclick="ocpRequestUpdate(this, '@device.DeviceId')">@L["Devices.UpdateNow"]</button>
                        }
                    </div>
                </section>
            }
        </div>
    }
</div>

@code {
    private Guid _familyId;
    private List<DeviceStatusDto> _devices = [];
    private string? _currentRelease;
    private string? _error;
    private Dictionary<Guid, string?> _updateStatuses = [];
    private Dictionary<Guid, NoticeSettings> _noticeSettings = new();
    private Dictionary<Guid, string?> _deviceLanguages = [];
    private Dictionary<Guid, bool> _notifyOffline = [];
    private Dictionary<Guid, bool> _notifyOnline = [];
    private Dictionary<Guid, string> _childNames = [];
    private Dictionary<Guid, string?> _timeZoneOverrides = [];
    private Dictionary<Guid, string> _reportedZoneDisplay = [];
    private Dictionary<Guid, MetricsView> _metrics = [];
    private Dictionary<Guid, List<DeviceWarningDto>> _warnings = [];
    private string _familyLanguage = AppCulture.English;

    private sealed record MetricsView(
        int CpuPercent,
        long RamUsedBytes,
        long RamTotalBytes,
        long DiskFreeBytes,
        long DiskTotalBytes,
        int? BatteryPercent,
        BatteryPowerState BatteryState,
        long UptimeSeconds,
        DateTime UpdatedUtc);

    private string FamilyLanguageLabel => _familyLanguage == AppCulture.Spanish ? L["Language.Spanish"] : L["Language.English"];

    private string UpdateStatusText(string status)
    {
        var value = status.Split(' ')[0];
        var translated = L["UpdateStatus." + value];
        return translated.ResourceNotFound ? status : status.Replace(value, translated.Value);
    }

    private static string OsLabel(DevicePlatform platform) => platform.ToString().ToUpperInvariant();

    private string ChildName(Guid childId) => _childNames.GetValueOrDefault(childId, "—");

    private async Task SetLanguageAsync(DeviceStatusDto device, string? language)
    {
        try
        {
            using var scope = Scopes.CreateScope();
            await scope.ServiceProvider.GetRequiredService<LanguageService>()
                .SetDeviceLanguageAsync(_familyId, device.DeviceId, language);
            _error = null;
            await RefreshAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
    }
    private bool _isOwner;
    private bool _canMessage;
    private sealed record NoticeSettings(bool Screen, bool Camera, bool Light);
    private static readonly IReadOnlyList<TimeZoneInfo> TimeZones = TimeZoneInfo.GetSystemTimeZones();

    private async Task SetNotifyOfflineAsync(Guid deviceId, bool enabled)
    {
        try
        {
            using var scope = Scopes.CreateScope();
            var db = scope.ServiceProvider.GetRequiredService<ParentalDbContext>();
            var row = await db.Devices.FirstOrDefaultAsync(d => d.Id == deviceId && d.FamilyId == _familyId);
            if (row is null) return;
            row.NotifyOffline = enabled;
            await db.SaveChangesAsync();
            _error = null;
            await RefreshAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task SetNotifyOnlineAsync(Guid deviceId, bool enabled)
    {
        try
        {
            using var scope = Scopes.CreateScope();
            var db = scope.ServiceProvider.GetRequiredService<ParentalDbContext>();
            var row = await db.Devices.FirstOrDefaultAsync(d => d.Id == deviceId && d.FamilyId == _familyId);
            if (row is null) return;
            row.NotifyOnline = enabled;
            await db.SaveChangesAsync();
            _error = null;
            await RefreshAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task SetTimeZoneAsync(DeviceStatusDto device, string? zoneId)
    {
        try
        {
            using var scope = Scopes.CreateScope();
            var db = scope.ServiceProvider.GetRequiredService<ParentalDbContext>();
            var row = await db.Devices.FirstOrDefaultAsync(d => d.Id == device.DeviceId && d.FamilyId == _familyId);
            if (row is null) return;
            DeviceTimeZonePolicy.ApplyOverride(row, zoneId);
            await db.SaveChangesAsync();
            _error = null;
            await RefreshAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private bool IsOutdatedCurrent(DeviceStatusDto device)
    {
        if (string.IsNullOrWhiteSpace(device.ClientVersion)) return true;
        if (_currentRelease is null) return false;
        return ReleaseCatalog.ParseVersion(device.ClientVersion) < ReleaseCatalog.ParseVersion(_currentRelease);
    }

    protected override async Task OnInitializedAsync()
    {
        _currentRelease = Releases.CurrentInfo()?.Version;
        var auth = await AuthState.GetAuthenticationStateAsync();
        Guid.TryParse(auth.User.FindFirst("family_id")?.Value, out _familyId);
        _isOwner = string.Equals(auth.User.FindFirst("family_role")?.Value, "Owner", StringComparison.OrdinalIgnoreCase);
        _canMessage = _isOwner || (int.TryParse(auth.User.FindFirst("permissions")?.Value, out var messagePermissions)
            && (messagePermissions & (int)OpControl.Parental.Contracts.ParentPermissions.Messaging) != 0);
        Events.DeviceStatusChanged += OnStatus;
        Events.DeviceMetricsChanged += OnMetrics;
        await RefreshAsync();
        await MetricsFocus.EnterAsync(_devices.Select(d => d.DeviceId));
    }

    private void OnStatus(DeviceStatusDto status) => _ = InvokeAsync(async () => { await RefreshAsync(); StateHasChanged(); });

    private void OnMetrics(Guid deviceId) => _ = InvokeAsync(async () => { await RefreshAsync(); StateHasChanged(); });

    private async Task RefreshAsync()
    {
        using var scope = Scopes.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<ParentalDbContext>();
        var devices = await db.Devices.AsNoTracking().Where(d => d.FamilyId == _familyId).OrderBy(d => d.Name).ToListAsync();
        var ids = devices.Select(d => d.Id).ToList();
        var accounts = await db.DeviceAccounts.AsNoTracking()
            .Where(a => ids.Contains(a.DeviceId))
            .GroupBy(a => a.DeviceId)
            .Select(g => new { DeviceId = g.Key, Account = g.Select(a => a.OsAccountName).FirstOrDefault() })
            .ToDictionaryAsync(x => x.DeviceId, x => x.Account);
        _devices = devices.Select(d => new DeviceStatusDto(d.Id, d.ChildId, d.Name, d.Platform, Presence.IsOnline(d.Id), d.LastSeenUtc, d.TimeZoneId, accounts.GetValueOrDefault(d.Id), d.ClientVersion)).ToList();
        _updateStatuses = devices.ToDictionary(d => d.Id, d => d.UpdateStatus is null ? null : $"{d.UpdateStatus} {d.UpdateTargetVersion}".Trim());
        _noticeSettings = devices.ToDictionary(d => d.Id, d => new NoticeSettings(d.ScreenNoticeEnabled, d.CameraNoticeEnabled, d.HasCameraLightOrShutter));
        _deviceLanguages = devices.ToDictionary(d => d.Id, d => d.ClientLanguage);
        _notifyOffline = devices.ToDictionary(d => d.Id, d => d.NotifyOffline);
        _notifyOnline = devices.ToDictionary(d => d.Id, d => d.NotifyOnline);
        _timeZoneOverrides = devices.ToDictionary(d => d.Id, d => d.TimeZoneOverrideId);
        _reportedZoneDisplay = devices.ToDictionary(d => d.Id, d => TimeZoneResolver.DisplayName(d.ReportedTimeZoneId ?? d.TimeZoneId));
        _metrics = devices
            .Where(d => d.MetricsUpdatedUtc is not null)
            .ToDictionary(d => d.Id, d => new MetricsView(
                d.MetricsCpuPercent ?? 0,
                d.MetricsRamUsedBytes ?? 0,
                d.MetricsRamTotalBytes ?? 0,
                d.MetricsDiskFreeBytes ?? 0,
                d.MetricsDiskTotalBytes ?? 0,
                d.MetricsBatteryPercent,
                d.MetricsBatteryState ?? BatteryPowerState.NoBattery,
                d.MetricsUptimeSeconds ?? 0,
                d.MetricsUpdatedUtc!.Value));
        var cutoff = DeviceWarningRetention.Cutoff(DateTime.UtcNow);
        var warnings = await db.DeviceWarnings.AsNoTracking()
            .Where(w => w.FamilyId == _familyId && w.StartedUtc >= cutoff)
            .OrderByDescending(w => w.StartedUtc)
            .ToListAsync();
        _warnings = warnings
            .GroupBy(w => w.DeviceId)
            .ToDictionary(g => g.Key, g => g.Take(20)
                .Select(w => new DeviceWarningDto(w.Id, w.Kind, w.StartedUtc, w.EndedUtc, w.PeakValue, w.Threshold, w.DurationSeconds))
                .ToList());
        _childNames = await db.Children.AsNoTracking()
            .Where(c => c.FamilyId == _familyId)
            .ToDictionaryAsync(c => c.Id, c => c.Name);
        _familyLanguage = AppCulture.Normalize(await db.Families.AsNoTracking().Where(f => f.Id == _familyId).Select(f => f.DefaultLanguage).FirstOrDefaultAsync());
    }

    private string SeenText(DeviceStatusDto device) =>
        device.LastSeenUtc is { } seen
            ? Formats.CompactDateTime(DashboardTime.Convert(seen, device.TimeZoneId))
            : L["Common.Never"].Value;

    private string Capacity(long usedBytes, long totalBytes) =>
        L["Devices.Capacity",
            (usedBytes / 1073741824.0).ToString("0.0", System.Globalization.CultureInfo.CurrentCulture),
            (totalBytes / 1073741824.0).ToString("0.0", System.Globalization.CultureInfo.CurrentCulture)].Value;

    private string BatteryText(BatteryPowerState state) => state switch
    {
        BatteryPowerState.OnBattery => L["Devices.BatteryOnBattery"].Value,
        BatteryPowerState.Charging => L["Devices.BatteryCharging"].Value,
        BatteryPowerState.PluggedInFull => L["Devices.BatteryPluggedIn"].Value,
        _ => L["Devices.BatteryNoBattery"].Value
    };

    private string UptimeText(long seconds)
    {
        var span = TimeSpan.FromSeconds(Math.Max(0, seconds));
        if (span.TotalDays >= 1)
            return L["Devices.UptimeDays", (int)span.TotalDays, span.Hours].Value;
        if (span.TotalHours >= 1)
            return L["Devices.UptimeHours", (int)span.TotalHours, span.Minutes].Value;
        return L["Devices.UptimeMinutes", span.Minutes].Value;
    }

    private string WarningDuration(DeviceWarningDto warning)
    {
        if (warning.DurationSeconds is not { } duration) return L["Devices.WarningOngoing"].Value;
        var minutes = Math.Max(0, duration / 60);
        return minutes < 1 ? L["Devices.WarningUnderMinute"].Value : L["Devices.WarningMinutes", minutes].Value;
    }

    private string UpdatedText(DateTime updatedUtc)
    {
        var age = DateTime.UtcNow - updatedUtc;
        if (age < TimeSpan.FromSeconds(10)) return L["Devices.UpdatedJustNow"].Value;
        if (age < TimeSpan.FromMinutes(1)) return L["Devices.UpdatedSecondsAgo", Math.Max(0, (int)age.TotalSeconds)].Value;
        if (age < TimeSpan.FromHours(1)) return L["Devices.UpdatedMinutesAgo", Math.Max(1, (int)age.TotalMinutes)].Value;
        return L["Devices.UpdatedHoursAgo", (int)age.TotalHours].Value;
    }

    private async Task SaveNoticeAsync(Guid deviceId, bool screen, bool camera, bool light)
    {
        try
        {
            await JS.InvokeAsync<bool>("ocpSaveDeviceNotice", deviceId, screen, camera, light);
            _error = null;
            await RefreshAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    public async ValueTask DisposeAsync()
    {
        Events.DeviceStatusChanged -= OnStatus;
        Events.DeviceMetricsChanged -= OnMetrics;
        await MetricsFocus.LeaveAsync(_devices.Select(d => d.DeviceId));
    }
}
