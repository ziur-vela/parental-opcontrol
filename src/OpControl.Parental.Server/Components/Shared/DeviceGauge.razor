<div class="device-gauge">
    <div class="device-gauge-ring">
        <svg viewBox="0 0 96 96" width="96" height="96" aria-hidden="true">
            <circle class="device-gauge-track" cx="48" cy="48" r="43.5"
                    stroke-dasharray="205 68.3" transform="rotate(135 48 48)" />
            <circle class="device-gauge-value @(Amber ? "amber" : "")" cx="48" cy="48" r="43.5"
                    stroke-dasharray="@ValueLength 273.3" transform="rotate(135 48 48)" />
        </svg>
        <span class="device-gauge-center">@Percent%</span>
    </div>
    <div class="device-gauge-label">@Label</div>
    <div class="device-gauge-caption">@Caption</div>
</div>

@code {
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public int Percent { get; set; }
    [Parameter] public string Caption { get; set; } = "";
    [Parameter] public bool Amber { get; set; }

    private string ValueLength =>
        (2 * Math.PI * 43.5 * 0.75 * Math.Clamp(Percent, 0, 100) / 100)
        .ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
}
